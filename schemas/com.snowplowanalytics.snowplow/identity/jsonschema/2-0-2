{
  "$schema": "http://iglucentral.com/schemas/com.snowplowanalytics.self-desc/schema/jsonschema/1-0-0#",
  "type": "object",
  "self": {
    "vendor": "com.snowplowanalytics.snowplow",
    "name": "identity",
    "format": "jsonschema",
    "version": "2-0-2"
  },
  "description": "Identity context that is enriched onto events by Snowplow Identities",
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "snowplow_id": {
      "type": "string",
      "maxLength": 29,
      "pattern": "^sp_[A-Za-z2-7]{26}$"
    },
    "decision_reasons": {
      "description": "Why the service made this decision. Absent when there is nothing to report.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "merged": {
      "description": "Roots the service merges into snowplow_id on this event. Provisional: an identity_correction of type withdrawal retracts a merge the database later refuses. Absent when the event merges nothing.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "snowplow_id": { "type": "string", "maxLength": 29, "pattern": "^sp_[A-Za-z2-7]{26}$" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["snowplow_id", "created_at"],
        "additionalProperties": false
      }
    }
  },
  "required": ["snowplow_id", "created_at"],
  "additionalProperties": false
}
