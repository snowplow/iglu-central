{
    "$schema": "http://iglucentral.com/schemas/com.snowplowanalytics.self-desc/schema/jsonschema/1-0-0#",
    "description": "Schema for agent classification context generated by agent classification enrichment",
    "self": {
        "vendor": "com.snowplowanalytics.snowplow",
        "name": "agent_classification",
        "format": "jsonschema",
        "version": "1-0-0"
    },

    "type": "object",
    "properties": {
        "operator": {
            "type": "string",
            "description": "The vendor operating the agent, e.g. OpenAI"
        },
        "purpose": {
            "type": ["string", "null"],
            "description": "The purpose of the agent, e.g. AI crawler, if known"
        }
    },
    "required": ["operator"],
    "additionalProperties": false
}
